{
  "schema": 1,
  "locked_kicad": "9.0.9",
  "require_custom_rules": true,
  "required_rule_patterns": ["Fine-pitch IC escape: U4 TMUX1101", "PEAK_GUARD guard trace"],
  "copper_layers": 2,
  "board_thickness_mm": 1.6,
  "copper_thickness_um": 35.0,
  "reference_planes": {"F.Cu": {"layer": "B.Cu", "net": "GND"}},
  "minimum_reference_coverage_percent": 95.0,
  "hypothetical_plane_distance_mm": 0.2,
  "layout_report_nets": ["/SIPM_RAW", "/AMP_IN", "/AMP_FB", "/AMP_OUT", "/COMP_RAW", "/TRIG", "/PEAK_HOLD", "/PEAK_GUARD", "/PEAK_OUT", "VBIAS", "+3.3V", "+5V"],
  "via_rule": {"drill_min_mm": 0.59, "drill_max_mm": 0.61, "annular_min_mm": 0.19},
  "fast_edges_ns": {"/COMP_RAW": 1.5, "/TRIG": 1.5},
  "sensitive_nets": ["/SIPM_RAW", "/AMP_IN", "/AMP_FB", "/AMP_OUT", "/PEAK_HOLD"],
  "aggressor_nets": ["/COMP_RAW", "/TRIG", "/PEAK_RESET", "VBIAS"],
  "supply_currents_ma": {"+3.3V": 11.0, "+5V": 48.0},
  "feedback_net": {"net": "/AMP_FB", "resistance_ohm": 12400.0},
  "noise_model": {"source_ohm": 49.9, "feedback_ohm": 12400.0, "gain_ohm": 1000.0, "gbw_hz": 120000000.0, "voltage_noise_nv_sqrt_hz": 6.5, "temperature_k": 300.0, "baseline_v": 0.05, "threshold_v": 0.1},
  "related_power_project": "hardware/power_interface/power_interface",
  "expect": {
    "coordinate_system": "lower_left_y_up",
    "outline_mm": [70.0, 70.0],
    "minimum_edge_arcs": 4,
    "allowed_back_footprints": ["D1"],
    "footprints": {
      "D1": {"side": "B.Cu", "value_regex": "^MICROFC-60035-SMT-TR$", "position_mm": [35.0, 35.0]},
      "J1": {"side": "F.Cu", "value_regex": "^B10B-XH-A$", "position_mm": [23.75, 8.0], "rotation_deg": 0.0},
      "U1": {"value_regex": "^TPH2502-SR$"},
      "U2": {"value_regex": "^TLV3502AIDR$"},
      "U3": {"value_regex": "^TPH2502-SR$"},
      "U4": {"value_regex": "^TMUX1101DCKR$", "dnp": true},
      "U5": {"value_regex": "^SN74LVC1G123DCTR$"},
      "Q1": {"value_regex": "^BSS138P,215$", "dnp": false},
      "D2": {"value_regex": "^BAS70,215$"},
      "D3": {"value_regex": "^BAT54S", "dnp": true},
      "C1": {"value_regex": "^100n$"},
      "R2": {"value_regex": "^499$"},
      "R5": {"value_regex": "^12.4k$"},
      "R6": {"value_regex": "^1.00k$"},
      "R13": {"value_regex": "^82(\\.0)?$", "dnp": false},
      "C16": {"value_regex": "^220p C0G$", "dnp": false},
      "R17": {"value_regex": "^0$", "dnp": false},
      "R18": {"value_regex": "^0$", "dnp": true},
      "H1": {"value_regex": "MountingHole_3.2mm", "position_mm": [5.0, 65.0], "drill_mm": 3.2},
      "H2": {"value_regex": "MountingHole_3.2mm", "position_mm": [65.0, 65.0], "drill_mm": 3.2},
      "H3": {"value_regex": "MountingHole_3.2mm", "position_mm": [65.0, 5.0], "drill_mm": 3.2},
      "H4": {"value_regex": "MountingHole_3.2mm", "position_mm": [5.0, 5.0], "drill_mm": 3.2}
    },
    "pad_nets": {
      "D1": {"1": "SIPM_RAW", "2": null, "3": "BIAS_LOCAL", "4": "GND"},
      "Q1": {"1": "PEAK_RESET", "2": "VBASE", "3": "PEAK_HOLD"},
      "U4": {"1": "PEAK_HOLD", "2": "VBASE", "3": "GND", "4": "PEAK_RESET", "5": "+5V"},
      "J1": {"1": "VBIAS", "2": "GND", "3": "+5V", "4": "GND", "5": "+3.3V", "6": "GND", "7": "TRIG", "8": "GND", "9": "PEAK_OUT", "10": "PEAK_RESET"}
    },
    "absent_pads": ["D1:5"],
    "pad_quadrants": [{"ref": "D1", "pad": "1", "quadrant": "-X,+Y"}],
    "proximity_checks": [
      {"name": "U1 +5 V local bypass", "first": {"ref": "U1", "pad": "8"}, "second": {"ref": "C2", "pad": "1"}, "max_mm": 3.0},
      {"name": "U1 ground return to local bypass", "first": {"ref": "U1", "pad": "4"}, "second": {"ref": "C2", "pad": "2"}, "max_mm": 3.0},
      {"name": "U3 +5 V local bypass", "first": {"ref": "U3", "pad": "8"}, "second": {"ref": "C17", "pad": "1"}, "max_mm": 3.0},
      {"name": "U3 ground return to local bypass", "first": {"ref": "U3", "pad": "4"}, "second": {"ref": "C17", "pad": "2"}, "max_mm": 3.0},
      {"name": "U5 +3.3 V local bypass", "first": {"ref": "U5", "pad": "8"}, "second": {"ref": "C15", "pad": "1"}, "max_mm": 3.0},
      {"name": "U5 ground return to local bypass", "first": {"ref": "U5", "pad": "4"}, "second": {"ref": "C15", "pad": "2"}, "max_mm": 3.0},
      {"name": "peak charger output to R_CHG", "first": {"ref": "U3", "pad": "1"}, "second": {"ref": "R13", "pad": "1"}, "max_mm": 3.0},
      {"name": "peak diode to hold capacitor", "first": {"ref": "D2", "pad": "3"}, "second": {"ref": "C16", "pad": "1"}, "max_mm": 3.0},
      {"name": "hold capacitor to buffer input", "first": {"ref": "C16", "pad": "1"}, "second": {"ref": "U3", "pad": "5"}, "max_mm": 3.0}
    ],
    "component_counts": [
      {"name": "two exact TPH2502-SR amplifiers", "value_regex": "^TPH2502-SR$", "min": 2},
      {"name": "exact TLV3502AIDR comparator", "value_regex": "^TLV3502AIDR$", "min": 1},
      {"name": "SN74LVC1G123DCTR one-shot", "value_regex": "^SN74LVC1G123DCTR$", "min": 1},
      {"name": "BAS70,215 peak diode", "value_regex": "^BAS70,215$", "min": 1}
    ],
    "required_nets": ["BIAS_LOCAL", "COMP_RAW", "TRIG", "PEAK_HOLD", "PEAK_GUARD", "PEAK_OUT", "PEAK_RESET"],
    "minimum_test_points": 20,
    "required_board_text": ["OPTICAL SIDE", "COMPONENT SIDE", "VTH + CW", "1:27V", "3:5V", "5:3.3V"],
    "related_component_regex": "^MCP3202-BI/SN$"
  },
  "simulations": [{
    "name": "head analog pulse and peak acquisition",
    "netlist": "hardware/muon_detector_head/analog-validation.cir",
    "assertions": [
      {"measurement": "amp_gain", "min": 12.5, "max": 14.3},
      {"measurement": "acquisition_error", "min": 0.0, "max": 0.01},
      {"measurement": "worst_charge_current", "min": 0.0, "max": 0.065}
    ]
  }]
}
